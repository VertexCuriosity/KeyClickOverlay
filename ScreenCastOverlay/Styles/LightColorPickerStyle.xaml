<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="UserControl" x:Key="DefaultColorPickerStyle">
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <!-- Use the light theme versions of the supporting style sheets -->
                    <ResourceDictionary Source="LightTabControlStyle.xaml" />
                    <ResourceDictionary Source="LightTextBoxStyle.xaml" />
                    <ResourceDictionary Source="LightComboBoxStyle.xaml" />
                    <ResourceDictionary Source="RoundedColorDisplayStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- Labels: dark text on light backgrounds -->
                <Style TargetType="Label">
                    <Setter Property="Foreground" Value="#111111" />
                </Style>

                <!-- Global grid background trigger for MainGrid -->
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="Name" Value="MainGrid">
                            <!-- Light neutral overlay background -->
                            <Setter Property="Background" Value="#F9F9F9" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

            </ResourceDictionary>
        </Style.Resources>
    </Style>
</ResourceDictionary>
