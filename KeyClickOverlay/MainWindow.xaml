<Window x:Class="KeyClickOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FocusVisualStyle="{x:Null}"
        Width="800" Height="130"
        BorderBrush="Transparent"
        ui:ThemeManager.IsThemeAware="True">

    <Border x:Name="RoundedVisualFrame"
        CornerRadius="12"
        BorderThickness="0"
        BorderBrush="Transparent"
        Background="{x:Null}">
        <Grid x:Name="MainGrid" Background="Transparent">


            <!-- === Invisible Resize Borders (active only in normal mode) === -->
            <Border Name="TopResize" Height="16" VerticalAlignment="Top" Cursor="SizeNS"
                    Background="Transparent" PreviewMouseDown="Resize_MouseDown"/>
            <Border Name="BottomResize" Height="16" VerticalAlignment="Bottom" Cursor="SizeNS"
                    Background="Transparent" PreviewMouseDown="Resize_MouseDown"/>
            <Border Name="LeftResize" Width="16" HorizontalAlignment="Left" Cursor="SizeWE"
                    Background="Transparent" PreviewMouseDown="Resize_MouseDown"/>
            <Border Name="RightResize" Width="16" HorizontalAlignment="Right" Cursor="SizeWE"
                    Background="Transparent" PreviewMouseDown="Resize_MouseDown"/>
            <Border Name="TopLeftResize" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"
                    Background="Transparent" PreviewMouseDown="Resize_MouseDown"/>
            <Border Name="TopRightResize" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"
                    Background="Transparent" PreviewMouseDown="Resize_MouseDown"/>
            <Border Name="BottomLeftResize" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"
                    Background="Transparent" PreviewMouseDown="Resize_MouseDown"/>
            <Border Name="BottomRightResize" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                    Background="Transparent" PreviewMouseDown="Resize_MouseDown"/>

            <!-- === Minimize / Close buttons (only shown in normal mode + hover) === -->
            <StackPanel x:Name="ChromeButtons"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0"
                        Visibility="Collapsed"
                        Opacity="0"
                        Panel.ZIndex="1000"
                        SnapsToDevicePixels="True">
                <!-- Local style for icon-only chrome buttons -->
                <StackPanel.Resources>
                    <Style x:Key="ChromeIconButton" TargetType="Button">
                        <!-- No spacing, no padding, no borders -->
                        <Setter Property="Width" Value="36"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <!-- White glyphs -->
                        <Setter Property="Foreground" Value="#B0B0B0"/>
                        <!-- Fully transparent by default -->
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>

                        <!-- Minimal template: border we can tint on hover/press -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root"
                                            CornerRadius="6"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Hover: faint background (optional) -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="#1AFFFFFF"/>
                                        </Trigger>
                                        <!-- Pressed: slightly stronger -->
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <!-- Minimize -->
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource ChromeIconButton}"
                        ToolTip="Minimize"
                        Click="MinimizeButton_Click">
                    <TextBlock Text="–"
                               FontSize="20"
                               Foreground="#B0B0B0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="{Binding FontSize, RelativeSource={RelativeSource Self}}"
                               Margin="0" Padding="0"/>
                </Button>

                <!-- Close -->
                <Button x:Name="CloseButton"
                        Style="{StaticResource ChromeIconButton}"
                        ToolTip="Close"
                        Click="CloseButton_Click">
                    <TextBlock Text="×"
                               FontSize="20"
                               Foreground="#B0B0B0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="{Binding FontSize, RelativeSource={RelativeSource Self}}"
                               Margin="0" Padding="0"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

</Window>
