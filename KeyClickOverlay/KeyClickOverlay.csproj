<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>12.0</LangVersion>

		<ApplicationIcon>KeyClickOverlay.ico</ApplicationIcon>
		<!-- This sets the app icon -->
		<EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Platforms>AnyCPU;x64</Platforms>

		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>

		<PublishSingleFile>false</PublishSingleFile>

		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<!-- Ensure Debug/Release x64 build as true x64 -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
		<PackageReference Include="ModernWpfUI" Version="0.9.6" />
		<PackageReference Include="MouseKeyHook" Version="5.7.1" />
		<PackageReference Include="PixiEditor.ColorPicker" Version="3.4.2.3" />
		<PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
	</ItemGroup>

	<!-- Generates the strongly-typed AppResources.Designer.cs from AppResources.resx (used for MouseIcon in taskbar thumbnail button). -->
	<ItemGroup>
		<Compile Update="AppResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppResources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<!-- Embeds AppResources.resx into the assembly and runs the ResXFileCodeGenerator so AppResources.MouseIcon (System.Drawing.Icon) is available at runtime. -->
	<ItemGroup>
		<EmbeddedResource Update="AppResources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>AppResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Include="assets\**\*" Exclude="assets\fonts\Inter-Regular.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="assets\fonts\Inter-Regular.ttf" />
	</ItemGroup>

</Project>