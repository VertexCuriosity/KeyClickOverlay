<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>

		<!-- Application information -->
		<Version>1.0.0</Version>
		<AssemblyTitle>Customizable keyboard and mouse input overlay.</AssemblyTitle>
		<Product>KeyClickOverlay</Product>
		<Description>Customizable keyboard and mouse input overlay.</Description>
		<Company>VertexCuriosity</Company>
		<Authors>Suus | VertexCuriosity</Authors>
		<Copyright>Copyright © 2026 VertexCuriosity</Copyright>

		<!-- Prevent Git commit hash from being appended to the product version -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>12.0</LangVersion>
		<!-- This sets the app icon -->
		<ApplicationIcon>KeyClickOverlay.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>

		<EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<Platforms>AnyCPU;x64</Platforms>

		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>

		<PublishSingleFile>false</PublishSingleFile>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
		<PackageReference Include="MouseKeyHook" Version="5.7.1" />
		<PackageReference Include="PixiEditor.ColorPicker" Version="3.4.2.3" />
		<PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
		<PackageReference Include="WPF-UI" Version="4.3.0" />
	</ItemGroup>

	<!-- Generates the strongly-typed AppResources.Designer.cs from AppResources.resx (used for MouseIcon in taskbar thumbnail button). -->
	<ItemGroup>
		<Compile Update="AppResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppResources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<!-- Embeds AppResources.resx into the assembly and runs the ResXFileCodeGenerator so AppResources.MouseIcon (System.Drawing.Icon) is available at runtime. -->
	<ItemGroup>
		<EmbeddedResource Update="AppResources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>AppResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Include="assets\**\*" Exclude="assets\fonts\Inter-Regular.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="KeyClickOverlay.ico" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="assets\fonts\Inter-Regular.ttf" />
	</ItemGroup>

</Project>