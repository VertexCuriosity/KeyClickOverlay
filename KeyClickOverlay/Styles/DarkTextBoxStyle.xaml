<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes for Light Theme -->
    <SolidColorBrush x:Key="SelectionColor" Color="#5E9BFF" /> <!-- Win11 accent blue -->
    <SolidColorBrush x:Key="MainColor" Color="#2B2B2B" /> <!-- default background -->
    <SolidColorBrush x:Key="AccentColor" Color="#414141" /> <!-- idle background -->
    <SolidColorBrush x:Key="DarkerAccentColor" Color="#414141" /> <!-- hover background -->
    <SolidColorBrush x:Key="BrighterAccentColor" Color="#555555" /> <!-- idle border -->
    <SolidColorBrush x:Key="AlmostLightModeAccentColor" Color="#292929" /> <!-- hover border -->

    <Style TargetType="TextBox">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="Snow" /> <!-- near-black text -->
        <Setter Property="SelectionBrush" Value="{StaticResource SelectionColor}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5" />
            </Style>
        </Style.Resources>

        <!-- Triggers -->
        <Style.Triggers>
            <!-- Idle -->
            <Trigger Property="IsMouseOver" Value="False">
                <Setter Property="Background" Value="{StaticResource AccentColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrighterAccentColor}" />
            </Trigger>

            <!-- Hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkerAccentColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource AlmostLightModeAccentColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
