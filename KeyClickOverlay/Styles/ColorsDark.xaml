<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme accent color (Win11 default blue) -->
    <SolidColorBrush x:Key="AccentColor" Color="#555555" />

    <!-- Optional supporting brushes (if you want more flexibility later) 
    <SolidColorBrush x:Key="AccentColorLight" Color="#88B6FF" />
    <SolidColorBrush x:Key="AccentColorDark" Color="#1E70FF" />
    <SolidColorBrush x:Key="AccentForeground" Color="#111111" />-->
</ResourceDictionary>
