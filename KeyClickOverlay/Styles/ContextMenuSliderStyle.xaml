<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Standalone Fluent slider based on the visual structure previously
        supplied implicitly by ModernWpfUI.
    -->

    <!-- Invisible RepeatButton chrome with a thin rounded track. -->
    <Style x:Key="ContextMenuSliderTrackButtonStyle"
           TargetType="{x:Type RepeatButton}">

        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid Background="Transparent">
                        <Border
                            Height="2"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            CornerRadius="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Fluent circular thumb. -->
    <Style x:Key="ContextMenuSliderThumbStyle"
           TargetType="{x:Type Thumb}">

        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />

        <Setter Property="Background"
                Value="{DynamicResource ContextMenuSliderThumbBrush}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid
                        Width="20"
                        Height="20"
                        Background="Transparent">

                        <Ellipse
                            x:Name="ThumbCircle"
                            Width="12"
                            Height="12"
                            Fill="{TemplateBinding Background}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Fluent pointer-over enlargement -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="ThumbCircle"
                                Property="Width"
                                Value="14" />

                            <Setter
                                TargetName="ThumbCircle"
                                Property="Height"
                                Value="14" />

                            <Setter
                                Property="Background"
                                Value="{DynamicResource ContextMenuSliderThumbHoverBrush}" />
                        </Trigger>

                        <!-- Fluent pressed contraction -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter
                                TargetName="ThumbCircle"
                                Property="Width"
                                Value="14" />

                            <Setter
                                TargetName="ThumbCircle"
                                Property="Height"
                                Value="14" />

                            <Setter
                                Property="Background"
                                Value="{DynamicResource ContextMenuSliderThumbHoverBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Horizontal Fluent slider used by the context menu. -->
    <Style x:Key="ContextMenuSliderStyle"
           TargetType="{x:Type Slider}">

        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">

                    <Grid
                        MinHeight="32"
                        Background="Transparent">

                        <Track
                            x:Name="PART_Track"
                            VerticalAlignment="Center"
                            Minimum="{TemplateBinding Minimum}"
                            Maximum="{TemplateBinding Maximum}"
                            IsDirectionReversed="{TemplateBinding IsDirectionReversed}">

                            <Track.Value>
                                <Binding
                                    Path="Value"
                                    RelativeSource="{RelativeSource TemplatedParent}"
                                    Mode="TwoWay" />
                            </Track.Value>

                            <!-- Filled part -->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Command="{x:Static Slider.DecreaseLarge}"
                                    Background="{DynamicResource ContextMenuSliderValueBrush}"
                                    Style="{StaticResource ContextMenuSliderTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>

                            <!-- Thumb -->
                            <Track.Thumb>
                                <Thumb
                                    Style="{StaticResource ContextMenuSliderThumbStyle}" />
                            </Track.Thumb>

                            <!-- Unfilled part -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Command="{x:Static Slider.IncreaseLarge}"
                                    Background="{DynamicResource ContextMenuSliderTrackBrush}"
                                    Style="{StaticResource ContextMenuSliderTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>

                        </Track>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="PART_Track"
                                Property="Tag"
                                Value="PointerOver" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter
                                TargetName="PART_Track"
                                Property="Opacity"
                                Value="0.4" />
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>